generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentCache {
  id           String    @id
  name         String
  class        Int
  rollNo       Int
  mobileNumber String
  email        String
  invoices     Invoice[]
}

model AcademicSession {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime

  feeStructures FeeStructure[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum FeeType {
  ONE_TIME
  RECURRING
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model FeeStructure {
  id          String          @id @default(uuid())
  name        String
  amount      Int
  feeType     FeeType
  frequency   FeeFrequency?
  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  invoiceItems InvoiceItem[]
}

model Invoice {
  id        String          @id @default(uuid())
  studentId String
  student   StudentCache    @relation(fields: [studentId], references: [id])
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  total     Int
  status    InvoiceStatus   @default(PENDING)
  dueDate   DateTime

  items     InvoiceItem[]
  payments  Payment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([studentId, sessionId]) // one invoice per student per session
}

model InvoiceItem {
  id             String       @id @default(uuid())  
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  month          Int? // only for recurring fees
  year           Int?
  amount         Int
  paid           Int          @default(0)
  waiver         Int          @default(0)
  pending        Int // auto = amount - (paid + waiver)
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Int
  method    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
}
